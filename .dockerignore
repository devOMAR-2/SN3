# Keep secrets, local state and development-only files out of the build context and image.
.git
.github
.env
.env.*
!.env.example
*.pem
*.key
auth.json

node_modules
vendor
public/build
public/hot
public/storage
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/private/*
storage/app/public/*
!**/.gitignore

tests
coverage
.phpunit.cache
.phpunit.result.cache
docs
assets
docker-compose.yml
docker-compose.*.yml
compose.yaml
.idea
.vscode
.DS_Store
Thumbs.db
*.log

# Keep secrets, local state and development-only files out of the build context and image.
.git
.github
.env
.env.*
!.env.example
*.pem
*.key
auth.json
backups
backup-passphrase

node_modules
vendor
public/build
public/hot
public/storage
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/private/*
storage/app/public/*
storage/app/exports
storage/app/attachments
!**/.gitignore

tests
e2e
playwright.config.ts
playwright-report
test-results
blob-report
coverage
.phpunit.cache
.phpunit.result.cache
docs
assets
docker-compose.yml
deploy/backup
docker-compose.*.yml
compose.yaml
.idea
.vscode
.DS_Store
Thumbs.db
*.log

# Test and static-analysis configuration (FND-003) is not needed in the image.
resources/js/**/*.test.ts
vitest.config.ts
phpstan.neon

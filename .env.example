# SN3 (سنع) environment template.
# Copy to .env and run `php artisan key:generate`. Never commit .env or real secrets.
# Every value below is a non-secret local-development default.

APP_NAME=SN3
APP_ENV=local
# Generated by `php artisan key:generate`; leave empty here.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Supported locales: ar (default, RTL) and en (LTR).
# Web requests resolve the locale per visitor (saved preference, session, Accept-Language, then ar);
# APP_LOCALE applies where there is no request, e.g. console commands and queued jobs.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Outside Docker in production, use LOG_STACK=daily: files rotate daily and are kept
# LOG_DAILY_DAYS days (30, the operational log retention of DECIDED-004).
LOG_DAILY_DAYS=30
# Docker Compose sets JSON lines on stderr (Monolog\Formatter\JsonFormatter). Leave empty
# locally for human-readable logs.
# LOG_STDERR_FORMATTER=

# PostgreSQL 16+ is the only supported database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sn3
DB_USERNAME=sn3
DB_PASSWORD=
# DB_SSLMODE=prefer

# Database-backed sessions, cache and queue keep Redis optional.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true whenever the app is served over HTTPS (always in production).
SESSION_SECURE_COOKIE=false

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted.
# Leave empty when not behind a proxy. docker-compose.yml supplies a default for its own network.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds before a reserved database-queue job is handed out again. Keep it above the
# worker's --timeout (60 s in docker-compose.yml).
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

# Optional: Redis is an enhancement, never a requirement.
# Nothing connects to it unless a connection/store/driver above is set to redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is written to the log until an SMTP server is configured.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Seconds to wait for the SMTP server. A queued mail that times out is retried, then lands
# in failed_jobs; the web request that queued it is never affected.
MAIL_TIMEOUT=10
# MAIL_MAILER=failover tries smtp, then falls back to log (the message is not delivered).
# The log mailer writes full messages, including sign-in links, only when this is true.
# Defaults to true when APP_ENV=local, false otherwise. Never enable it in production.
# MAIL_LOG_BODY=

# Optional: any S3-compatible object storage. Local disk is used when unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Accounts and limits (FND-004, see docs/adr/ADR-016) ---
# Public sign-up. Self-hosted operators may close it; existing users can still sign in.
SN3_REGISTRATION_ENABLED=true
# Optional breached-password check via the Have I Been Pwned range API (k-anonymity). Off by default.
SN3_PASSWORD_BREACH_CHECK=false
# Verification link lifetime in minutes.
SN3_VERIFICATION_EXPIRE_MINUTES=60
# Requests per minute per signed-in user (per IP for guests) and per-second burst cap. 0 disables a
# limit (self-hosted only; Cloud uses 120/min, DECIDED-004).
SN3_RATE_LIMIT_PER_MINUTE=120
SN3_RATE_LIMIT_BURST_PER_SECOND=20
# Auth endpoints: failed sign-ins per email+IP (the per-IP cap is 4x this), registrations,
# password-reset requests per IP, and verification emails per user, each per minute.
SN3_RATE_LIMIT_LOGIN_PER_MINUTE=5
SN3_RATE_LIMIT_REGISTER_PER_MINUTE=5
SN3_RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=5
SN3_RATE_LIMIT_VERIFICATION_PER_MINUTE=6
# Project create and PATCH per user per minute; slows probing of project keys (ADR-020 §10).
SN3_RATE_LIMIT_PROJECT_WRITES_PER_MINUTE=20
# Team export requests per user per hour (CORE-012, ADR-024). 0 disables (self-hosted only).
SN3_RATE_LIMIT_TEAM_EXPORTS_PER_HOUR=10

# --- Team exports (CORE-012, see docs/adr/ADR-024) ---
# Private disk for export archives (config/filesystems.php). The default `exports` disk is
# storage/app/exports; archives are deleted 24 hours after they complete.
SN3_EXPORTS_DISK=exports

# --- Docker Compose (docker-compose.yml) only; ignored by the application ---
# Host interface and port the app container is published on. Keep 127.0.0.1 unless a
# trusted reverse proxy on another host must reach it (see docs/SELF_HOSTING.md).
SN3_HTTP_BIND=127.0.0.1
SN3_HTTP_PORT=8080
# Public hostname and host ports for the optional Caddy proxy (`--profile proxy`).
# Automatic certificates need the standard ports 80/443.
SN3_DOMAIN=localhost
SN3_PROXY_HTTP_PORT=80
SN3_PROXY_HTTPS_PORT=443
# Log level inside the containers (info by default; debug only while troubleshooting).
# SN3_LOG_LEVEL=info
# Encrypted daily backups (`--profile backup`, docs/BACKUP_RESTORE.md). The passphrase file's
# first line (16+ characters) encrypts every backup: keep a copy off this host. Sets older than
# the retention are deleted; SN3_BACKUP_AT is the daily time in UTC.
SN3_BACKUP_HOST_DIR=./backups
SN3_BACKUP_PASSPHRASE_HOST_FILE=./backup-passphrase
SN3_BACKUP_RETENTION_DAYS=14
SN3_BACKUP_AT=02:30
